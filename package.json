{
  "name": "@cinatra-ai/email-drafting-agent",
  "version": "0.1.7",
  "license": "Apache-2.0",
  "files": [
    "cinatra"
  ],
  "description": "Generates personalized initial emails for every recipient.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "Email Drafting Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/email-artifacts",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      }
    ],
    "fieldRenderers": [
      {
        "id": "@cinatra-ai/email-drafting-agent:output",
        "kind": "email-drafts-review",
        "priority": 80,
        "a2uiTranslator": "drafts-output"
      }
    ],
    "consumes": [],
    "produces": [
      {
        "extension": "@cinatra-ai/email-artifacts",
        "objectTypeId": "@cinatra-ai/email:body"
      }
    ],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "email-drafting-flow",
    "sourceVersionId": "63943b92-95b7-4d38-96ff-c4046226aaa7",
    "sourceVersionNumber": 1,
    "riskLevel": "low",
    "hasApprovalGates": true,
    "toolAccess": [],
    "ownerOrgId": null
  }
}
