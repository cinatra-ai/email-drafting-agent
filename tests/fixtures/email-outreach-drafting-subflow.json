    },
    {
      "component_type": "ControlFlowEdge",
      "name": "drafts-approval_gate_to_end",
      "from_node": {
        "$component_ref": "drafts-approval_gate"
      },
      "to_node": {
        "$component_ref": "drafts-end"
      }
    }
