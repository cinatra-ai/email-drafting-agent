      "source_node": {
        "$component_ref": "drafts-start"
      },
      "source_output": "offeringCompanyWebsite",
      "destination_node": {
        "$component_ref": "drafts-draft"
      },
      "destination_input": "offeringCompanyWebsite"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-start_to_draft_callToAction",
      "source_node": {
        "$component_ref": "drafts-start"
      },
      "source_output": "callToAction",
      "destination_node": {
        "$component_ref": "drafts-draft"
      },
      "destination_input": "callToAction"
    },
    {
      "component_type": "DataFlowEdge",
