      "source_node": {
        "$component_ref": "drafts-start"
      },
      "source_output": "senderName",
      "destination_node": {
        "$component_ref": "drafts-draft"
      },
      "destination_input": "senderName"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-start_to_draft_confirmedRecipientsRef",
      "source_node": {
        "$component_ref": "drafts-start"
      },
      "source_output": "confirmedRecipientsRef",
      "destination_node": {
        "$component_ref": "drafts-draft"
      },
      "destination_input": "confirmedRecipientsRef"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-draft_to_end_draftBundleRef",
      "source_node": {
        "$component_ref": "drafts-draft"
      },
      "source_output": "draftBundleRef",
      "destination_node": {
        "$component_ref": "drafts-end"
      },
      "destination_input": "draftBundleRef"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-start_to_uuid_match_text",
      "source_node": {
        "$component_ref": "drafts-start"
      },
      "source_output": "confirmedRecipientsRef",
      "destination_node": {
        "$component_ref": "drafts-uuid_match"
      },
      "destination_input": "text"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-uuid_match_to_predicate_matches",
      "source_node": {
        "$component_ref": "drafts-uuid_match"
      },
      "source_output": "output",
      "destination_node": {
        "$component_ref": "drafts-check_inputs_predicate"
      },
      "destination_input": "matches"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-predicate_to_check_inputs_verdict",
      "source_node": {
        "$component_ref": "drafts-check_inputs_predicate"
      },
      "source_output": "output",
      "destination_node": {
        "$component_ref": "drafts-check_inputs"
      },
      "destination_input": "verdict"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-start_to_draft_contextSlotBindings",
      "source_node": {
        "$component_ref": "drafts-start"
      },
      "source_output": "contextSlotBindings",
      "destination_node": {
        "$component_ref": "drafts-draft"
      },
      "destination_input": "contextSlotBindings"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-draft_to_approval_gate_draftBodyArtifacts",
      "source_node": {
        "$component_ref": "drafts-draft"
      },
      "source_output": "draftBodyArtifacts",
      "destination_node": {
        "$component_ref": "drafts-approval_gate"
      },
      "destination_input": "draftBodyArtifacts"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-draft_to_approval_gate_draftBundleRef",
      "source_node": {
        "$component_ref": "drafts-draft"
      },
      "source_output": "draftBundleRef",
      "destination_node": {
        "$component_ref": "drafts-approval_gate"
      },
      "destination_input": "draftBundleRef"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-start_to_read_drafts_agent_run_id",
      "source_node": {
        "$component_ref": "drafts-start"
      },
      "source_output": "agent_run_id",
      "destination_node": {
        "$component_ref": "drafts-read_drafts"
      },
      "destination_input": "agent_run_id"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-draft_to_read_drafts_draftBundleRef",
      "source_node": {
        "$component_ref": "drafts-draft"
      },
      "source_output": "draftBundleRef",
      "destination_node": {
        "$component_ref": "drafts-read_drafts"
      },
      "destination_input": "draftBundleRef"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-read_drafts_to_approval_gate_draftBundle",
      "source_node": {
        "$component_ref": "drafts-read_drafts"
      },
      "source_output": "draftBundle",
      "destination_node": {
        "$component_ref": "drafts-approval_gate"
      },
      "destination_input": "draftBundle"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "drafts-approval_gate_to_end_userResponse",
      "source_node": {
        "$component_ref": "drafts-approval_gate"
      },
      "source_output": "userResponse",
      "destination_node": {
        "$component_ref": "drafts-end"
      },
      "destination_input": "userResponse"
    }
  ],
  "$referenced_components": {
    "drafts-start": {
      "component_type": "StartNode",
      "id": "drafts-start",
      "name": "Inputs",
      "metadata": {
        "cinatra": {
          "required": [],
          "hidden": [
            "agent_run_id",
            "offeringCompanyWebsite",
            "callToAction",
            "senderName",
            "confirmedRecipientsRef",
            "contextSlotBindings",
            "draftBundleRef",
            "campaignId"
          ]
        }
      },
      "inputs": [
        {
          "title": "agent_run_id",
          "type": "string",
          "default": ""
        },
        {
          "title": "offeringCompanyWebsite",
          "type": "string",
          "default": ""
        },
        {
          "title": "callToAction",
          "type": "string",
          "default": ""
        },
        {
          "title": "senderName",
          "type": "string",
          "default": ""
        },
        {
          "title": "confirmedRecipientsRef",
          "type": "string",
          "default": ""
        },
        {
          "title": "contextSlotBindings",
          "type": "array",
          "default": [],
          "json_schema": {
            "items": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string"
                },
                "representationRevisionId": {
                  "type": "string"
                },
                "semanticAssertionId": {
                  "type": "string"
                },
                "extension": {
                  "type": "string"
                },
                "sourceScope": {
                  "type": "string"
                },
                "ownerId": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "title": "draftBundleRef",
          "type": "string",
          "default": ""
        },
        {
          "title": "campaignId",
          "type": "string",
          "json_schema": {
            "format": "uuid"
          },
          "default": ""
        }
      ]
    },
    "drafts-draft": {
      "component_type": "ApiNode",
      "id": "drafts-draft",
      "name": "Draft emails",
      "url": "{{CINATRA_BASE_URL}}/api/llm-bridge",
      "http_method": "POST",
      "data": {
        "system": "You are an email drafting agent.\n\nStep 1: Call objects_get with confirmedRecipientsRef to fetch the recipients list.\n\nStep 1b: For each entry of contextSlotBindings, call artifact_representation_get({ artifactId, representationRevisionId }) to read the pinned context the operator selected. Read the context ONLY through that road \u2014 never reach for the parent run's slot or project. Skip an entry the road refuses.\n\nStep 2: Generate exactly one personalized initial outreach email per recipient using offeringCompanyWebsite, callToAction, and senderName as context.\n\nStep 3 \u2014 CRITICAL: Call objects_save BEFORE returning any JSON. Use exactly this structure:\n  objects_save({\n    typeHint: \"@cinatra-ai/campaigns:email-draft-bundle\",\n    rawData: {\n      cinatra_agent_run_id: \"<agent_run_id input>\",\n      drafts: [\n        { recipientEmail: \"...\", subject: \"...\", body: \"...\", status: \"draft\" }\n      ]\n    }\n  })\n\nStep 4: Return ONLY this JSON using the object ID returned by objects_save: {\"draftBundleRef\":\"<objectId returned by objects_save>\",\"draftBodyArtifacts\":[{\"artifactId\":\"<id>\",\"representationRevisionId\":\"<revision>\"}],\"summary\":\"<one sentence summary>\"}. draftBodyArtifacts lists one @cinatra-ai/email:body artifact per draft, in recipient order, so the review screen can display the bodies themselves.\n\nDo NOT return draftBundleRef without completing Step 3. Never skip objects_save. Do not send emails \u2014 this agent only drafts.",
        "user": "Execute the email drafting task now and return the result as JSON.\nInputs:\n- offeringCompanyWebsite: {{ offeringCompanyWebsite }}\n- callToAction: {{ callToAction }}\n- senderName: {{ senderName }}\n- confirmedRecipientsRef: {{ confirmedRecipientsRef }}\n- contextSlotBindings: {{ contextSlotBindings }}",
        "agent_id": "email-drafting",
        "agent_run_id": "{{ agent_run_id }}"
      },
      "outputs": [
        {
          "title": "draftBundleRef",
          "type": "string",
          "json_schema": {
            "format": "uuid"
          }
        },
        {
          "title": "draftBodyArtifacts",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string"
                },
                "representationRevisionId": {
                  "type": "string"
                }
              }
            }
          }
        }
      ],
      "metadata": {
        "cinatra": {
          "riskClass": "draft_create",
          "requiresApproval": true,
          "renderer": "@cinatra-ai/email-drafting-agent:output",
          "a2uiSurfaceId": "email-drafting:step-1:output"
        }
      },
      "inputs": [
        {
          "title": "agent_run_id",
          "type": "string",
          "default": ""
        },
        {
          "title": "offeringCompanyWebsite",
          "type": "string",
          "default": ""
        },
        {
          "title": "callToAction",
          "type": "string",
          "default": ""
        },
        {
          "title": "senderName",
          "type": "string",
          "default": ""
        },
        {
          "title": "confirmedRecipientsRef",
          "type": "string",
          "default": ""
        },
        {
          "title": "contextSlotBindings",
          "type": "array",
          "default": [],
          "json_schema": {
            "items": {
              "type": "object"
            }
          }
        }
      ]
    },
    "drafts-read_drafts": {
      "component_type": "ApiNode",
      "id": "drafts-read_drafts",
      "name": "Read the saved drafts for the review",
      "url": "{{CINATRA_BASE_URL}}/api/agents/passthrough",
      "http_method": "POST",
      "data": {
        "tool": "extension_tool",
        "input": {
          "name": "saved_drafts",
          "input": {
            "draftBundleRef": "{{ draftBundleRef }}"
          }
        },
        "agent_run_id": "{{ agent_run_id }}"
      },
      "inputs": [
        {
          "title": "agent_run_id",
          "type": "string",
          "default": ""
        },
        {
          "title": "draftBundleRef",
          "type": "string",
          "default": ""
        }
      ],
      "outputs": [
        {
          "title": "draftBundle",
          "type": "object",
          "default": {}
        },
        {
          "title": "ok",
          "type": "boolean",
          "default": false
        }
      ],
      "metadata": {
        "cinatra": {
          "riskClass": "read_only",
          "requiresApproval": false,
          "description": "The agent reads the drafts this run saved and hands them to the drafts review, so the review shows the drafts that the approval and the send act on. A saved bundle that is missing, holds no drafts or has a draft without a recipient ends the run with its reason before the review."
        }
      }
    },
    "drafts-end": {
      "component_type": "EndNode",
      "id": "drafts-end",
      "name": "End",
      "outputs": [
        {
          "title": "userResponse",
          "type": "string",
          "default": ""
        },
        {
          "title": "draftBundleRef",
          "type": "string",
          "json_schema": {
            "format": "uuid"
          },
          "default": ""
        }
      ]
    },
    "drafts-approval_gate": {
      "component_type": "InputMessageNode",
      "id": "drafts-approval_gate",
      "name": "Review drafts",
      "metadata": {
        "cinatra": {
          "riskClass": "approval",
          "requiresApproval": true,
          "renderer": "@cinatra-ai/email-drafting-agent:email-drafts-review",
          "a2uiSurfaceId": "email-drafting:review:input",
          "autoSkipWhenInputsPresent": false,
          "description": "Read the drafted emails, then approve, send them back for revision, or reject the run.",
          "inputMessageSchema": {
            "type": "object",
            "x-renderer": "@cinatra-ai/email-drafting-agent:email-drafts-review",
            "properties": {
              "draftBodyArtifacts": {
                "type": "array",
                "title": "Drafted emails",
                "x-artifact-kind": "@cinatra-ai/email:body",
                "x-artifact-read": "artifact_representation_get",
                "items": {
                  "type": "object"
                },
                "readOnly": true
              },
              "draftBundleRef": {
                "type": "string",
                "title": "Draft bundle",
                "readOnly": true
              },
              "draftBundle": {
                "type": "object",
                "title": "Drafts",
                "readOnly": true
              },
              "decision": {
                "type": "string",
                "title": "Decision",
                "enum": [
                  "approve",
                  "revise",
                  "reject"
                ],
                "description": "Approve the step, send it back for revision, or reject the run."
              },
              "note": {
                "type": "string",
                "title": "Note"
              }
            },
            "required": [
              "decision"
            ]
          },
          "surfaceGateInputs": true
        }
      },
      "outputs": [
        {
          "title": "userResponse",
          "type": "string"
        }
      ],
      "inputs": [
        {
          "title": "draftBodyArtifacts",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "object"
            }
          }
        },
        {
          "title": "draftBundleRef",
          "type": "string",
          "default": ""
        },
        {
          "title": "draftBundle",
          "type": "object",
          "default": {}
        }
      ]
    },
    "drafts-uuid_match": {
      "component_type": "PluginRegexNode",
      "id": "drafts-uuid_match",
      "name": "drafts-uuid_match",
      "metadata": {},
      "inputs": [
        {
          "title": "text",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "title": "output",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "branches": [
        "next"
      ],
      "input_mapping": {},
      "output_mapping": {},
      "regex_pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "return_first_match_only": false,
      "component_plugin_name": "NodesPlugin",
      "component_plugin_version": "26.1.0"
    },
    "drafts-check_inputs_predicate": {
      "component_type": "PluginTemplateNode",
      "id": "drafts-check_inputs_predicate",
      "name": "drafts-check_inputs_predicate",
      "metadata": {},
      "inputs": [
        {
          "title": "matches"
        }
      ],
      "outputs": [
        {
          "title": "output",
          "type": "string"
        }
      ],
      "branches": [
        "next"
      ],
      "input_mapping": {},
      "output_mapping": {},
      "template": "{% if matches and (matches|length > 0) %}present{% else %}missing{% endif %}",
      "component_plugin_name": "NodesPlugin",
      "component_plugin_version": "26.1.0"
    },
    "drafts-check_inputs": {
      "component_type": "BranchingNode",
      "id": "drafts-check_inputs",
      "name": "drafts-check_inputs",
      "metadata": {
        "cinatra": {
          "purpose": "skip-data_gate-when-confirmedRecipientsRef-is-valid-uuid"
        }
      },
      "inputs": [
        {
          "title": "verdict",
          "type": "string"
        }
      ],
      "outputs": [],
      "branches": [
        "default",
        "skip"
      ],
      "mapping": {
        "present": "skip"
      }
    },
    "drafts-inputs_missing": {
      "component_type": "OutputMessageNode",
      "id": "drafts-inputs_missing",
      "name": "No recipients to draft for",
      "inputs": [],
      "message": "This run stopped before drafting: no approved recipient list reached the drafting step, so there was nobody to write to. Start the campaign again and approve a recipient list first.",
      "metadata": {
        "cinatra": {
          "purpose": "plain-language-ending-for-the-retired-data-gate"
        }
      }
    }
  }
}
