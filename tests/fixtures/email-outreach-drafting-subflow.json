    },
    {
      "$component_ref": "drafts-end"
    }
  ],
  "control_flow_connections": [
    {
      "component_type": "ControlFlowEdge",
      "name": "drafts-start_to_uuid_match",
      "from_node": {
        "$component_ref": "drafts-start"
      },
      "to_node": {
