    {
      "title": "draftBundleRef",
      "type": "string",
      "default": ""
    },
    {
      "title": "campaignId",
      "type": "string",
      "json_schema": {
        "format": "uuid"
      },
      "default": ""
    }
  ],
  "outputs": [
    {
      "title": "userResponse",
      "type": "string"
    },
    {
      "title": "draftBundleRef",
      "type": "string",
      "json_schema": {
