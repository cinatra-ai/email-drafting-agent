{
  "agentspec_version": "26.1.0",
  "component_type": "Flow",
  "id": "email-drafting-subflow",
  "name": "Email Drafting Agent",
  "inputs": [
    {
      "title": "agent_run_id",
      "type": "string",
      "default": ""
    },
    {
      "title": "offeringCompanyWebsite",
      "type": "string",
      "default": ""
    },
    {
      "title": "callToAction",
      "type": "string",
      "default": ""
    },
    {
      "title": "senderName",
      "type": "string",
      "default": ""
    },
    {
      "title": "confirmedRecipientsRef",
      "type": "string",
      "default": ""
    },
    {
      "title": "contextSlotBindings",
      "type": "array",
      "default": [],
