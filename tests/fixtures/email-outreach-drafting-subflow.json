      }
    },
    {
      "component_type": "ControlFlowEdge",
      "name": "drafts-uuid_match_to_predicate",
      "from_node": {
        "$component_ref": "drafts-uuid_match"
      },
      "to_node": {
        "$component_ref": "drafts-check_inputs_predicate"
      }
    },
    {
      "component_type": "ControlFlowEdge",
      "name": "drafts-predicate_to_check_inputs",
      "from_node": {
        "$component_ref": "drafts-check_inputs_predicate"
      },
      "to_node": {
        "$component_ref": "drafts-check_inputs"
      }
    },
    {
      "component_type": "ControlFlowEdge",
      "name": "drafts-check_inputs_skip_to_draft",
      "from_node": {
        "$component_ref": "drafts-check_inputs"
      },
